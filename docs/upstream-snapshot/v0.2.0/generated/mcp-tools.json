    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "events": {
          "description": "Events in document coordinates: `[{\"kind\":\"down|move|up\",\"x\":..,\"y\":..,\"pressure\":..}]`.",
          "items": true,
          "type": "array"
        },
        "modifiers": {
          "default": null,
          "description": "Modifier keys, e.g. `{\"shift\":true}`."
        }
      },
      "required": [
        "events"
      ],
      "type": "object"
    }
  },
  {
    "name": "ui_screenshot",
