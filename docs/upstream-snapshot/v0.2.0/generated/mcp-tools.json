  {
    "name": "ui_set",
    "description": "Bridge mode: change UI state (tool, panels, zoom, center, dark).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "fields": {
          "description": "Fields accepted by the control method `ui.set` (tool, panels, zoom, center, dark)."
        }
