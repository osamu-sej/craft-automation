[
  {
    "name": "command_batch",
    "description": "Run several engine commands in one call (fewer round trips). Returns {completed, failed, results:[{ok, result|error}]}; stops at the first error unless stop_on_error is false.",
    "inputSchema": {
      "$defs": {
        "RunParams": {
          "properties": {
            "id": {
              "description": "Command id, e.g. `layer.new.layer`, `filter.blur.gaussian`.",
              "type": "string"
            },
            "params": {
              "default": null,
              "description": "Command parameters as a JSON object (see the `params` doc in `command_list`)."
            }
          },
          "required": [
            "id"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "steps": {
          "description": "Commands to run in order: `[{\"id\": \"layer.new.layer\", \"params\": {\"name\": \"Ink\"}}, …]`.",
          "items": {
            "$ref": "#/$defs/RunParams"
          },
          "type": "array"
        },
        "stop_on_error": {
          "default": null,
          "description": "Stop at the first failing step (default true).",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "steps"
      ],
      "type": "object"
    }
  },
  {
    "name": "command_list",
    "description": "List engine commands: id, label, menu path, shortcut, parameter doc, enabled now.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "enabled_only": {
          "default": null,
          "description": "Only commands that can run right now.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "filter": {
          "default": null,
          "description": "Only commands whose id or label contains this text (case-insensitive).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "command_run",
    "description": "Run an engine command by id with JSON params (see command_list). Returns the command's JSON result.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "description": "Command id, e.g. `layer.new.layer`, `filter.blur.gaussian`.",
          "type": "string"
        },
        "params": {
          "default": null,
          "description": "Command parameters as a JSON object (see the `params` doc in `command_list`)."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  {
    "name": "control_call",
    "description": "Bridge mode: call any control-protocol method (docs/control-protocol.md) with raw params.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "method": {
          "description": "Any control-protocol method, e.g. `ui.dialog.open`.",
          "type": "string"
        },
        "params": {
          "default": null
        }
      },
      "required": [
        "method"
      ],
      "type": "object"
    }
  },
  {
    "name": "doc_close",
    "description": "Close a document (default: the active one) without saving.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "index": {
          "default": null,
          "description": "Document index from `session_list` (default: the active document).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "doc_export",
    "description": "Export the document to another format (same as doc_save with an explicit path/format).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "format": {
          "default": null,
          "description": "Format override as an extension (pcraft, psd, png, jpg, tif, webp, exr, …).",
          "type": [
            "string",
            "null"
          ]
        },
        "index": {
          "default": null,
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "default": null,
          "description": "Forward-slash relative target beneath the configured automation write root.\nThe extension selects the format. Omit to save to the document's own relative path.",
          "type": [
            "string",
            "null"
          ]
        },
        "quality": {
          "default": null,
          "description": "JPEG quality 1..100 for lossy exports.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "doc_inspect",
    "description": "Document state as JSON: layer tree (top to bottom), history, selection, active layer.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "index": {
          "default": null,
          "description": "Document index from `session_list` (default: the active document).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "doc_new",
    "description": "Create a new document (defaults: 1920x1080 RGB 8-bit white).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "background": {
          "default": null,
          "description": "white | black | transparent | #rrggbb",
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "default": null,
          "description": "8 | 16 | 32",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "height": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "mode": {
          "default": null,
          "description": "rgb | gray | cmyk | lab",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "doc_open",
    "description": "Open an image or document file and make it active. Returns index, size and import warnings.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "path": {
          "description": "Forward-slash relative path beneath the configured automation read root.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    }
  },
  {
    "name": "doc_render_preview",
    "description": "Render the flattened document and return it as a PNG image (bridge mode: window screenshot).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "index": {
          "default": null,
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_side": {
          "default": null,
          "description": "Longest side of the returned PNG in pixels (default 1024, 0 = full size).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "doc_save",
    "description": "Save the document. `.pcraft` is the lossless native format (incremental); other extensions (psd, png, jpg, tif, webp, exr, …) export. Returns warnings about anything the format cannot hold.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "format": {
          "default": null,
          "description": "Format override as an extension (pcraft, psd, png, jpg, tif, webp, exr, …).",
          "type": [
            "string",
            "null"
          ]
        },
        "index": {
          "default": null,
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "default": null,
          "description": "Forward-slash relative target beneath the configured automation write root.\nThe extension selects the format. Omit to save to the document's own relative path.",
          "type": [
            "string",
            "null"
          ]
        },
        "quality": {
          "default": null,
          "description": "JPEG quality 1..100 for lossy exports.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "doc_select",
    "description": "Make the document at `index` active.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "index": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "index"
      ],
      "type": "object"
    }
  },
  {
    "name": "session_list",
    "description": "List open documents (index, name, size, dirty) and the active index.",
    "inputSchema": {
      "properties": {},
      "type": "object"
    }
  },
  {
    "name": "ui_inspect",
    "description": "Bridge mode: full UI state of the live app (tool, panels, views, dialogs, menu tree).",
    "inputSchema": {
      "properties": {},
      "type": "object"
    }
  },
  {
